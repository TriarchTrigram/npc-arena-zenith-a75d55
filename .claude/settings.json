{
  "model": "claude-sonnet-5[1m]",
  "permissions": {
    "deny": [
      "Edit(app/generated/**)",
      "Write(app/generated/**)",
      "Edit(app/.stencil/**)",
      "Write(app/.stencil/**)"
    ]
  },
  "hooks": {
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dev-tools instructions-loaded"
          }
        ]
      }
    ]
  }
}
